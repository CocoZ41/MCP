{
  "openapi": "3.1.0",
  "info": {
    "title": "API CRM APL",
    "description": "Documentation de l'API CRM APL.\n\nCette API donne accès en lecture aux données du CRM Dynamics 365 d'APL (clients, équipes, produits,\nopportunités, abonnements) et permet de rouvrir une opportunité.\nLes données sont mises en cache 6 heures, sauf `/clients/{accountId}/opportunites` qui interroge le CRM en direct.\n\nToutes les réponses suivent le même format : un bloc `header` (statut, message, total, nombre)\nsuivi des données. Les champs sans valeur ne sont pas renvoyés.\n\nLes mêmes fonctionnalités sont proposées sous forme d'outils MCP sur `/mcp`.\n",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://{hote}/api",
      "description": "Accès via le tunnel (Dev Tunnels)",
      "variables": {
        "hote": {
          "default": "hczjl37p-53801.uks1.devtunnels.ms",
          "description": "Nom d'hôte du tunnel affiché par `devtunnel host mcp-crm`"
        }
      }
    },
    {
      "url": "http://localhost:53801/api",
      "description": "Poste de développement"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Client",
      "description": "API clients (fiches, équipes, opportunités d'un client)"
    },
    {
      "name": "Produit",
      "description": "API produits (catalogue et lignes produits d'opportunité)"
    },
    {
      "name": "Opportunite",
      "description": "API opportunités"
    },
    {
      "name": "Abonnement",
      "description": "API abonnements"
    }
  ],
  "paths": {
    "/clients": {
      "get": {
        "tags": [
          "Client"
        ],
        "summary": "Recherche de clients",
        "description": "Recherche les clients dont le nom ou le n° de dossier contient le texte `q`. Sans `q`, renvoie les premiers clients.",
        "operationId": "rechercherClients",
        "parameters": [
          {
            "$ref": "#/components/parameters/q"
          },
          {
            "$ref": "#/components/parameters/nombre"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseClients"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/MauvaiseRequete"
          },
          "401": {
            "$ref": "#/components/responses/NonAutorise"
          },
          "404": {
            "$ref": "#/components/responses/NonTrouve"
          },
          "500": {
            "$ref": "#/components/responses/ErreurInterne"
          }
        }
      }
    },
    "/clients/{identifiant}": {
      "get": {
        "tags": [
          "Client"
        ],
        "summary": "Fiche d'un client",
        "description": "Renvoie la fiche détaillée d'un client (adresse, SIREN, email de facturation, contacts) à partir de son AccountId ou de son n° de dossier.",
        "operationId": "findClient",
        "parameters": [
          {
            "name": "identifiant",
            "in": "path",
            "description": "AccountId (Guid CRM) ou n° de dossier du client",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "123456"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseClient"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NonAutorise"
          },
          "404": {
            "$ref": "#/components/responses/NonTrouve"
          },
          "500": {
            "$ref": "#/components/responses/ErreurInterne"
          }
        }
      }
    },
    "/clients/{identifiant}/equipe": {
      "get": {
        "tags": [
          "Client"
        ],
        "summary": "Fiche d'un client avec son équipe",
        "description": "Renvoie en une seule réponse la fiche d'un client (adresse, SIREN, e-mail de facturation, contacts) et son équipe APL (liste `affectations` avec les 9 rôles : Réviseur, Logistique, Réviseur 2, Responsable dossier, Responsable RH, Expert signataire, Expert comptable, Responsable juridique, Commercial APL). Recherche par AccountId ou n° de dossier exact. À utiliser pour « donne-moi le client 07876 et son équipe ».",
        "operationId": "findClientEquipe",
        "parameters": [
          {
            "name": "identifiant",
            "in": "path",
            "description": "AccountId (Guid CRM) ou n° de dossier du client",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "07876"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseClientEquipe"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NonAutorise"
          },
          "404": {
            "$ref": "#/components/responses/NonTrouve"
          },
          "500": {
            "$ref": "#/components/responses/ErreurInterne"
          }
        }
      }
    },
    "/clients/{accountId}/opportunites": {
      "get": {
        "tags": [
          "Client",
          "Opportunite"
        ],
        "summary": "Opportunités d'un client",
        "description": "Renvoie le résumé des opportunités d'un client, lues directement dans le CRM (pas de cache).",
        "operationId": "opportunitesClient",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "description": "AccountId (Guid CRM) du client",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/nombre"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseOpportunites"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/MauvaiseRequete"
          },
          "401": {
            "$ref": "#/components/responses/NonAutorise"
          },
          "404": {
            "$ref": "#/components/responses/NonTrouve"
          },
          "500": {
            "$ref": "#/components/responses/ErreurInterne"
          }
        }
      }
    },
    "/equipes": {
      "get": {
        "tags": [
          "Client"
        ],
        "summary": "Personnes assignées à un dossier client, avec leur rôle",
        "description": "Renvoie, pour chaque dossier client dont le nom ou le n° de dossier contient `q`, la liste des personnes APL assignées avec leur rôle. La liste `affectations` contient toujours les 9 rôles, dans cet ordre : Réviseur, Logistique, Réviseur 2, Responsable dossier, Responsable RH, Expert signataire, Expert comptable, Responsable juridique, Commercial APL. Chaque personne a un nom complet, un e-mail, un téléphone et un mobile. Quand personne n'est assigné à un rôle, l'entrée ne contient que `role` et `remarque` (« Personne n'est assigné à ce rôle »). Indique aussi la forme juridique et le statut du client. À utiliser pour toute question du type « qui travaille sur le dossier X », « qui est assigné à », « qui est le responsable dossier / l'expert comptable / le réviseur de X », « collaborateurs », « équipe », « affectations ». Répondre uniquement à partir de ces données, sans jamais inventer de personne.",
        "operationId": "rechercherEquipes",
        "parameters": [
          {
            "$ref": "#/components/parameters/q"
          },
          {
            "$ref": "#/components/parameters/nombre"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseEquipes"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/MauvaiseRequete"
          },
          "401": {
            "$ref": "#/components/responses/NonAutorise"
          },
          "404": {
            "$ref": "#/components/responses/NonTrouve"
          },
          "500": {
            "$ref": "#/components/responses/ErreurInterne"
          }
        }
      }
    },
    "/produits": {
      "get": {
        "tags": [
          "Produit"
        ],
        "summary": "Recherche dans le catalogue produits",
        "description": "Recherche les produits du catalogue dont le libellé contient `q`. Sans `q`, renvoie les premiers produits.",
        "operationId": "rechercherProduits",
        "parameters": [
          {
            "$ref": "#/components/parameters/q"
          },
          {
            "$ref": "#/components/parameters/nombre"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseProduits"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/MauvaiseRequete"
          },
          "401": {
            "$ref": "#/components/responses/NonAutorise"
          },
          "404": {
            "$ref": "#/components/responses/NonTrouve"
          },
          "500": {
            "$ref": "#/components/responses/ErreurInterne"
          }
        }
      }
    },
    "/lignesProduits/{id}": {
      "get": {
        "tags": [
          "Produit"
        ],
        "summary": "Détail d'une ligne produit d'opportunité",
        "operationId": "findLigneProduit",
        "parameters": [
          {
            "$ref": "#/components/parameters/idLigneProduit"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseLigneProduit"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/MauvaiseRequete"
          },
          "401": {
            "$ref": "#/components/responses/NonAutorise"
          },
          "404": {
            "$ref": "#/components/responses/NonTrouve"
          },
          "500": {
            "$ref": "#/components/responses/ErreurInterne"
          }
        }
      }
    },
    "/lignesProduits/{id}/opportunite": {
      "get": {
        "tags": [
          "Produit",
          "Opportunite"
        ],
        "summary": "Opportunité contenant une ligne produit",
        "description": "Renvoie l'opportunité complète, avec toutes ses lignes produits, qui contient la ligne produit donnée.",
        "operationId": "findOpportuniteDuProduit",
        "parameters": [
          {
            "$ref": "#/components/parameters/idLigneProduit"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseOpportunite"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/MauvaiseRequete"
          },
          "401": {
            "$ref": "#/components/responses/NonAutorise"
          },
          "404": {
            "$ref": "#/components/responses/NonTrouve"
          },
          "500": {
            "$ref": "#/components/responses/ErreurInterne"
          }
        }
      }
    },
    "/opportunites": {
      "get": {
        "tags": [
          "Opportunite"
        ],
        "summary": "Recherche d'opportunités",
        "description": "Recherche les opportunités dont le nom ou le n° de dossier contient `q` et renvoie leur résumé.",
        "operationId": "rechercherOpportunites",
        "parameters": [
          {
            "$ref": "#/components/parameters/q"
          },
          {
            "$ref": "#/components/parameters/nombre"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseOpportunites"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/MauvaiseRequete"
          },
          "401": {
            "$ref": "#/components/responses/NonAutorise"
          },
          "404": {
            "$ref": "#/components/responses/NonTrouve"
          },
          "500": {
            "$ref": "#/components/responses/ErreurInterne"
          }
        }
      }
    },
    "/opportunites/{id}/reouverture": {
      "post": {
        "tags": [
          "Opportunite"
        ],
        "summary": "Réouverture d'une opportunité",
        "description": "**Écriture dans le CRM de production.** Rouvre une opportunité fermée.\nRéservé aux clés d'API ayant le rôle `ecriture`. Chaque appel est tracé dans le journal d'audit.\n",
        "operationId": "rouvrirOpportunite",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id (Guid) de l'opportunité",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseErreur"
                },
                "example": {
                  "header": {
                    "statut": 200,
                    "message": "Opportunité 3f2a1c4e-0000-0000-0000-000000000000 rouverte"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/MauvaiseRequete"
          },
          "401": {
            "$ref": "#/components/responses/NonAutorise"
          },
          "403": {
            "$ref": "#/components/responses/Interdit"
          },
          "500": {
            "$ref": "#/components/responses/ErreurInterne"
          }
        }
      }
    },
    "/abonnements": {
      "get": {
        "tags": [
          "Abonnement"
        ],
        "summary": "Recherche d'abonnements",
        "description": "Recherche les abonnements par n° de dossier, libellé ou AccountId (Guid) du client.",
        "operationId": "rechercherAbonnements",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "N° de dossier, libellé ou AccountId (Guid) du client",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/nombre"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseAbonnements"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/MauvaiseRequete"
          },
          "401": {
            "$ref": "#/components/responses/NonAutorise"
          },
          "404": {
            "$ref": "#/components/responses/NonTrouve"
          },
          "500": {
            "$ref": "#/components/responses/ErreurInterne"
          }
        }
      }
    },
    "/collaborateurs/dossiers": {
      "get": {
        "tags": [
          "Client"
        ],
        "summary": "Dossiers d'un collaborateur APL, avec son rôle sur chacun",
        "description": "Sens inverse de l'équipe : pour un collaborateur APL recherché par nom ou e-mail (paramètre `q`, obligatoire), renvoie la liste de ses dossiers clients avec son rôle sur chacun. Le paramètre `role` filtre sur un rôle (par exemple « Expert comptable »). Renvoie au maximum `nombre` personnes (20 par défaut) et 100 dossiers par personne ; `nombreDossiers` donne le total. À utiliser pour « sur quels dossiers travaille X », « quels sont les clients de X », « quels dossiers X a-t-il comme expert comptable ».",
        "operationId": "rechercherDossiersCollaborateur",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Nom ou e-mail (ou partie) du collaborateur APL, sans tenir compte des majuscules",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "barel"
          },
          {
            "$ref": "#/components/parameters/role"
          },
          {
            "$ref": "#/components/parameters/nombre"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseCollaborateurs"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/MauvaiseRequete"
          },
          "401": {
            "$ref": "#/components/responses/NonAutorise"
          },
          "404": {
            "$ref": "#/components/responses/NonTrouve"
          },
          "500": {
            "$ref": "#/components/responses/ErreurInterne"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      }
    },
    "parameters": {
      "q": {
        "name": "q",
        "in": "query",
        "description": "Texte recherché (nom ou n° de dossier), sans tenir compte des majuscules",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": "dupont"
      },
      "nombre": {
        "name": "nombre",
        "in": "query",
        "description": "Nombre maximal d'éléments renvoyés",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "idLigneProduit": {
        "name": "id",
        "in": "path",
        "description": "Id (Guid) de la ligne produit d'opportunité",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "role": {
        "name": "role",
        "in": "query",
        "description": "Filtre sur le rôle (optionnel), par exemple « Expert comptable » ou « Responsable dossier »",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": "Expert comptable"
      }
    },
    "responses": {
      "MauvaiseRequete": {
        "description": "Nombre incorrect de paramètres ou les paramètres sont mal formatés",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ReponseErreur"
            }
          }
        }
      },
      "NonAutorise": {
        "description": "Clé d'API absente ou invalide (en-tête X-Api-Key)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ReponseErreur"
            }
          }
        }
      },
      "Interdit": {
        "description": "Droits insuffisants (rôle `ecriture` requis)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ReponseErreur"
            }
          }
        }
      },
      "NonTrouve": {
        "description": "Aucun élément trouvé",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ReponseErreur"
            }
          }
        }
      },
      "ErreurInterne": {
        "description": "Erreur interne du serveur ou du CRM",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ReponseErreur"
            }
          }
        }
      }
    },
    "schemas": {
      "Header": {
        "type": "object",
        "required": [
          "statut",
          "message"
        ],
        "properties": {
          "statut": {
            "type": "integer",
            "description": "Code retour HTTP",
            "examples": [
              200
            ]
          },
          "message": {
            "type": "string",
            "description": "Message accompagnant le code retour",
            "examples": [
              "OK"
            ]
          },
          "total": {
            "type": "integer",
            "description": "Nombre total d'éléments correspondant à la recherche (listes uniquement)",
            "examples": [
              42
            ]
          },
          "nombre": {
            "type": "integer",
            "description": "Nombre d'éléments renvoyés (listes uniquement)",
            "examples": [
              20
            ]
          }
        }
      },
      "ReponseErreur": {
        "type": "object",
        "required": [
          "header"
        ],
        "properties": {
          "header": {
            "$ref": "#/components/schemas/Header"
          }
        }
      },
      "ReponseClients": {
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/Header"
          },
          "clients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientResume"
            }
          }
        }
      },
      "ReponseClient": {
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/Header"
          },
          "client": {
            "$ref": "#/components/schemas/ClientDetail"
          }
        }
      },
      "ReponseEquipes": {
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/Header"
          },
          "equipes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EquipeClient"
            }
          }
        }
      },
      "ReponseProduits": {
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/Header"
          },
          "produits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Produit"
            }
          }
        }
      },
      "ReponseLigneProduit": {
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/Header"
          },
          "ligneProduit": {
            "$ref": "#/components/schemas/LigneProduit"
          }
        }
      },
      "ReponseOpportunites": {
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/Header"
          },
          "opportunites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpportuniteResume"
            }
          }
        }
      },
      "ReponseOpportunite": {
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/Header"
          },
          "opportunite": {
            "$ref": "#/components/schemas/Opportunite"
          }
        }
      },
      "ReponseAbonnements": {
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/Header"
          },
          "abonnements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Abonnement"
            }
          }
        }
      },
      "ClientResume": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid",
