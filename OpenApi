openapi: 3.1.0

info:
  title: API MCP AplInvoicing
  version: 1.0.0
  summary: Consultation et mise à jour des dossiers clients AplInvoicing via le protocole MCP.
  description: |
    L'API MCP AplInvoicing donne accès aux dossiers clients de la base AplInvoicing
    au travers du protocole Model Context Protocol (MCP), transport « Streamable HTTP ».

    ## Fonctionnement

    L'API expose un point d'entrée unique, `/mcp`, qui reçoit des messages JSON-RPC 2.0.
    Un client MCP (agent, assistant IA) commence par l'appel `initialize`, liste ensuite
    les outils disponibles avec `tools/list`, puis les exécute avec `tools/call`.

    Outils disponibles :

    | Outil | Rôle requis | Description |
    |---|---|---|
    | `rechercher_clients` | lecture | Recherche les clients dont le nom contient un texte (20 résultats au maximum). |
    | `modifier_email_client` | écriture | Modifie l'adresse email d'un client sur tous ses dossiers. |
    | `modifier_id_client` | écriture | Remplace l'identifiant d'un client sur tous ses dossiers. |

    ## Authentification

    Chaque requête doit comporter l'en-tête `X-Api-Key`. Une clé est attribuée par
    utilisateur ou par agent, avec un rôle `lecture` ou `ecriture`. Une requête sans clé
    valide reçoit une réponse `401`. Les outils de modification refusent les clés de rôle
    `lecture`.

    ## Format des identifiants

    Les identifiants clients sont composés de 3 lettres majuscules suivies de 5 chiffres
    (exemple : `JTU00001`). Les minuscules sont acceptées et converties automatiquement.

    ## Données à caractère personnel

    Les données renvoyées (noms, adresses email) sont des données à caractère personnel.
    Leur utilisation est soumise au RGPD et aux règles internes de l'entreprise.
    Toutes les modifications sont journalisées avec l'identité de l'utilisateur.

servers:
  - url: https://dnb7d11l-5000.uks1.devtunnels.ms
    description: Tunnel de test (adresse publique)
  - url: http://localhost:5000
    description: Poste de développement

tags:
  - name: MCP
    description: Point d'entrée du protocole Model Context Protocol (JSON-RPC 2.0).

security:
  - cleApi: []

paths:
  /mcp:
    post:
      tags:
        - MCP
      summary: Envoyer un message MCP
      description: |
        Reçoit un message JSON-RPC 2.0 du protocole MCP et renvoie la réponse correspondante.
        Le serveur fonctionne en mode sans état : chaque requête est traitée indépendamment,
        sans en-tête de session.
      operationId: envoyerMessageMcp
      parameters:
        - $ref: '#/components/parameters/Accept'
        - $ref: '#/components/parameters/VersionProtocole'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RequeteJsonRpc'
            examples:
              initialisation:
                summary: Initialiser la connexion
                value:
                  jsonrpc: '2.0'
                  id: 1
                  method: initialize
                  params:
                    protocolVersion: '2025-06-18'
                    capabilities: {}
                    clientInfo:
                      name: client-exemple
                      version: '1.0'
              listeOutils:
                summary: Lister les outils disponibles
                value:
                  jsonrpc: '2.0'
                  id: 2
                  method: tools/list
              rechercherClients:
                summary: Rechercher les clients nommés « pierre »
                value:
                  jsonrpc: '2.0'
                  id: 3
                  method: tools/call
                  params:
                    name: rechercher_clients
                    arguments:
                      nom: pierre
              modifierEmailClient:
                summary: Modifier l'email d'un client
                value:
                  jsonrpc: '2.0'
                  id: 4
                  method: tools/call
                  params:
                    name: modifier_email_client
                    arguments:
                      id: CLI00957
                      nouvelEmail: pierre.dupont@exemple.fr
              modifierIdClient:
                summary: Remplacer l'identifiant d'un client
                value:
                  jsonrpc: '2.0'
                  id: 5
                  method: tools/call
                  params:
                    name: modifier_id_client
                    arguments:
                      ancienId: CLI01699
                      nouvelId: JTU00001
      responses:
        '200':
          description: Réponse JSON-RPC (succès ou erreur applicative).
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ReponseJsonRpc'
              examples:
                resultatRecherche:
                  summary: Résultat de rechercher_clients
                  value:
                    jsonrpc: '2.0'
                    id: 3
                    result:
                      content:
                        - type: text
                          text: '[{"Id":"JTU00001","Nom":"Pierre Lambert","Email":"pierre.lambert@sfr.fr"}]'
                      isError: false
                accesRefuse:
                  summary: Modification refusée (rôle lecture)
                  value:
                    jsonrpc: '2.0'
                    id: 4
                    result:
                      content:
                        - type: text
                          text: "Accès refusé : l'utilisateur stagiaire n'a que des droits de lecture."
                      isError: false
            text/event-stream:
              schema:
                type: string
                description: Flux Server-Sent Events contenant la réponse JSON-RPC.
        '202':
          description: Notification acceptée (aucune réponse attendue, par exemple `notifications/initialized`).
        '400':
          $ref: '#/components/responses/RequeteInvalide'
        '401':
          $ref: '#/components/responses/NonAutorise'
        '406':
          $ref: '#/components/responses/NonAcceptable'
        '500':
          $ref: '#/components/responses/ErreurInterne'

components:
  securitySchemes:
    cleApi:
      type: apiKey
      in: header
      name: X-Api-Key
      description: Clé d'API personnelle, attribuée par l'administrateur avec un rôle `lecture` ou `ecriture`.

  parameters:
    Accept:
      name: Accept
      in: header
      required: true
      description: Le client doit accepter les deux formats de réponse du transport Streamable HTTP.
      schema:
        type: string
        example: application/json, text/event-stream
    VersionProtocole:
      name: MCP-Protocol-Version
      in: header
      required: false
      description: Version du protocole MCP négociée lors de l'initialisation.
      schema:
        type: string
        example: '2025-06-18'

  responses:
    RequeteInvalide:
      description: Le corps de la requête n'est pas un message JSON-RPC valide.
    NonAutorise:
      description: En-tête `X-Api-Key` absent ou clé inconnue.
    NonAcceptable:
      description: L'en-tête `Accept` n'autorise pas `application/json` et `text/event-stream`.
    ErreurInterne:
      description: Erreur interne du serveur.

  schemas:
    RequeteJsonRpc:
      type: object
      description: Message JSON-RPC 2.0 envoyé par le client MCP.
      required:
        - jsonrpc
        - method
      properties:
        jsonrpc:
          const: '2.0'
        id:
          description: Identifiant de la requête, absent pour une notification.
          type:
            - string
            - integer
        method:
          type: string
          enum:
            - initialize
            - notifications/initialized
            - ping
            - tools/list
            - tools/call
        params:
          oneOf:
            - $ref: '#/components/schemas/ParametresInitialisation'
            - $ref: '#/components/schemas/ParametresAppelOutil'
            - type: object

    ParametresInitialisation:
      type: object
      required:
        - protocolVersion
        - capabilities
        - clientInfo
      properties:
        protocolVersion:
          type: string
          example: '2025-06-18'
        capabilities:
          type: object
        clientInfo:
          type: object
          required:
            - name
            - version
          properties:
            name:
              type: string
            version:
              type: string

    ParametresAppelOutil:
      type: object
      description: Paramètres de la méthode `tools/call`.
      required:
        - name
        - arguments
      properties:
        name:
          type: string
          enum:
            - rechercher_clients
            - modifier_email_client
            - modifier_id_client
        arguments:
          oneOf:
            - $ref: '#/components/schemas/ArgumentsRechercherClients'
            - $ref: '#/components/schemas/ArgumentsModifierEmailClient'
            - $ref: '#/components/schemas/ArgumentsModifierIdClient'

    IdentifiantClient:
      type: string
      description: Identifiant client, 3 lettres suivies de 5 chiffres.
      pattern: '^[A-Za-z]{3}[0-9]{5}$'
      example: JTU00001

    ArgumentsRechercherClients:
      type: object
      required:
        - nom
      properties:
        nom:
          type: string
          description: Texte à chercher dans le nom du client.
          example: pierre

    ArgumentsModifierEmailClient:
      type: object
      required:
        - id
        - nouvelEmail
      properties:
        id:
          $ref: '#/components/schemas/IdentifiantClient'
        nouvelEmail:
          type: string
          format: email
          example: pierre.dupont@exemple.fr

    ArgumentsModifierIdClient:
      type: object
      required:
        - ancienId
        - nouvelId
      properties:
        ancienId:
          $ref: '#/components/schemas/IdentifiantClient'
        nouvelId:
          $ref: '#/components/schemas/IdentifiantClient'

    ReponseJsonRpc:
      type: object
      required:
        - jsonrpc
      properties:
        jsonrpc:
          const: '2.0'
        id:
          type:
            - string
            - integer
        result:
          $ref: '#/components/schemas/ResultatOutil'
        error:
          $ref: '#/components/schemas/ErreurJsonRpc'

    ResultatOutil:
      type: object
      description: Résultat d'un appel `tools/call`.
      properties:
        content:
          type: array
          items:
            type: object
            required:
              - type
              - text
            properties:
              type:
                const: text
              text:
                type: string
                description: Texte renvoyé par l'outil (JSON pour une recherche, message pour une modification).
        isError:
          type: boolean

    Client:
      type: object
      description: Client tel que renvoyé (en JSON dans le texte) par `rechercher_clients`.
      properties:
        Id:
          type:
            - string
            - 'null'
          example: JTU00001
        Nom:
          type:
            - string
            - 'null'
          example: Pierre Lambert
        Email:
          type:
            - string
            - 'null'
          format: email
          example: pierre.lambert@sfr.fr

    ErreurJsonRpc:
      type: object
      required:
        - code
        - message
      properties:
        code:
          type: integer
          example: -32602
        message:
          type: string
        data: {}
